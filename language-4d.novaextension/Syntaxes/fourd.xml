<?xml version="1.0" encoding="UTF-8"?>
<syntax name="fourd">
    <meta>
        <name>4D</name>
        <type>compiled</type>
        <preferred-file-extension>4dm</preferred-file-extension>
    </meta>

    <detectors>
        <extension priority="1.0">4dm</extension>
        <!-- attributes header at the top of exported project methods -->
        <match-content lines="1" priority="0.6">^//%attributes\s*=</match-content>
    </detectors>

    <indentation>
        <increase>
            <expression>^\s*((?i:If|Else|While|Repeat|Try|Catch|Case of|For each|For|Begin SQL)\b|:\s*\(|(\w+\s+)*(?i:Function|Class constructor)\b)</expression>
        </increase>
        <decrease>
            <expression>^\s*(?i:End (if|case|while|for each|for|try|SQL)|Else|Until\b|Catch\b)</expression>
        </decrease>
    </indentation>

    <comments>
        <single>
            <expression>//</expression>
        </single>
        <multiline>
            <starts-with>
                <expression>/*</expression>
            </starts-with>
            <ends-with>
                <expression>*/</expression>
            </ends-with>
        </multiline>
    </comments>

    <brackets>
        <pair open="{" close="}" />
        <pair open="[" close="]" />
        <pair open="(" close=")" />
    </brackets>

    <surrounding-pairs>
        <pair open="{" close="}" />
        <pair open="[" close="]" />
        <pair open="(" close=")" />
        <pair open="&quot;" close="&quot;" />
    </surrounding-pairs>

    <tree-sitter>
        <highlights />
        <symbols />
        <folds />
        <injections />
    </tree-sitter>
</syntax>
